{
    "expo": {
        "name": "mensola",
        "slug": "mensola",
        "version": "0.12.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "mensola",
        "userInterfaceStyle": "automatic",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "package": "com.enescdev.mensola",
            "versionCode": 1,
            "adaptiveIcon": {
                "backgroundColor": "#080C12",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#080C12",
                    "dark": {
                        "backgroundColor": "#080C12"
                    }
                }
            ],
            "expo-font",
            "expo-image",
            "expo-status-bar",
            "expo-web-browser",
            "expo-secure-store",
            "expo-sharing",
            "@react-native-google-signin/google-signin",
            "@react-native-community/datetimepicker"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "66a45943-5b2a-4fd8-927b-b684adea56b9"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/66a45943-5b2a-4fd8-927b-b684adea56b9"
        }
    }
}
